# --- Local dev (npm run dev) ---
# Prefer same-origin proxy so the browser does not need CORS on the API.
# Copy these into .env.development or .env.local (see repo .env.development).
#
#   VITE_API_BASE_URL=/api
#   VITE_DEV_PROXY_TARGET=http://localhost:8080
#
# Postman / curl reference (what the dev proxy forwards to after stripping /api):
#   curl --location 'http://localhost:8080/events?page=0&size=20&sort=dateTime%2Casc'
#
# Optional tuning:
#   VITE_EVENTS_PAGE_SIZE=20
#   VITE_ADMIN_EVENTS_PAGE_SIZE=500

# --- Production or “browser talks directly to API” ---
# Full origin (no Vite proxy). Your server must send CORS headers for the web origin.
# Example: https://api.technicalbeep.com
VITE_API_BASE_URL=https://your-api.example.com

# true = mock data only (no network). false = use VITE_API_BASE_URL.
VITE_USE_MOCK_API=false
