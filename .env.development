# Dev: browser calls same-origin /api/* → Vite proxies to your JVM/API (avoids CORS).
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false
# Match Postman: curl 'http://localhost:8080/events?page=0&size=20&sort=dateTime,asc'
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Page size for GET /events (raise if the map should show more than one page of results).
VITE_EVENTS_PAGE_SIZE=20
# Admin list (listAll): larger page so the dashboard sees more rows in one request.
VITE_ADMIN_EVENTS_PAGE_SIZE=500
